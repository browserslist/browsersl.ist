{
  "name": "browsersl.ist",
  "private": true,
  "homepage": "https://browsersl.ist/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "pnpm -r start",
    "prebuild": "pnpm -r prebuild",
    "build": "pnpm -r build",
    "test:js": "oxlint .",
    "test:css": "stylelint .",
    "test:checks": "node scripts/check-versions.js",
    "test:audit": "pnpm audit --prod",
    "test-no-build": "pnpm run --recursive --include-workspace-root /^test:/",
    "test": "pnpm run prebuild && pnpm build && pnpm test-no-build"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.1.0",
    "@logux/stylelint-config": "^1.0.1",
    "actions-up": "^1.18.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1"
    }
  },
  "packageManager": "pnpm@12.0.0"
}
