{
  "name": "browsersl.ist",
  "private": true,
  "homepage": "https://browsersl.ist/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "pnpm -r start",
    "prebuild": "pnpm -r prebuild",
    "build": "pnpm -r build",
    "test:js": "oxlint .",
    "test:css": "stylelint .",
    "test:checks": "node scripts/check-versions.js",
    "test:audit": "pnpm audit --prod",
    "test": "pnpm run prebuild && pnpm build && pnpm run --recursive --include-workspace-root /^test:/"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.2.0",
    "@logux/stylelint-config": "^1.1.0",
    "actions-up": "^1.21.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0"
    }
  },
  "packageManager": "pnpm@12.10.0"
}
